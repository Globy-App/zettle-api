{
  "name": "globyapp/zettle-api",
  "description": "Zettle by PayPal API PHP Client",
  "license": "MIT",
  "authors": [
    {
      "name": "Justin Ruiter",
      "email": "globy@justinruiter.nl"
    },
	{
		"name": "Pierre",
		"email": "dev@nettools.ovh",
		"role": "Developer"
	},
    {
      "name": "Laurens Laman",
      "email": "laurens.laman@llaman.nl"
    }
  ],
  "autoload": {
    "psr-4": {
      "GlobyApp\\Zettle\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "GlobyApp\\Zettle\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": "^8.1",
    "guzzlehttp/guzzle": "^6.3 || ^7.4.5",
    "moneyphp/money": "^3.0 || ^4.0",
    "ramsey/uuid": "^3.7 || ^4.0",
    "ext-json": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.5",
    "mockery/mockery": "^1.5",
    "friendsofphp/php-cs-fixer": "^3.9",
    "phpstan/phpstan": "^1.10",
    "phpstan/phpstan-deprecation-rules": "^1.1",
    "vimeo/psalm": "^5",
    "infection/infection": "^0.27.11"
  },
  "scripts": {
    "test": [
      "composer exec phpunit"
    ],
    "lint": [
      "vendor/bin/php-cs-fixer fix src --dry-run --allow-risky=yes"
    ],
    "lint:fix": [
      "vendor/bin/php-cs-fixer fix src --allow-risky=yes"
    ],
    "phpstan": [
      "php -d memory_limit=1G ./vendor/bin/phpstan analyse -c phpstan.neon"
    ],
    "psalm": [
      "php ./vendor/bin/psalm"
    ],
    "phpunit": [
      "php ./vendor/bin/phpunit"
    ],
    "coverage": [
      "php ./vendor/bin/phpunit --coverage-html=coverage.html"
    ],
    "infection": [
      "php ./vendor/bin/infection"
    ]
  },
  "scripts-descriptions": {
    "test": "Run all unit and integration tests",
    "test-unit": "Run unit tests",
    "test-integration": "Run integration tests",
    "test-coverage": "Run unit and integration tests and generate coverage report",
    "format": "Run php-cs-fixer to fix the code formatting"
  },
  "config": {
    "allow-plugins": {
      "infection/extension-installer": true
    }
  }
}
